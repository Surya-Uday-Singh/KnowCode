# Copy this file to .env and fill in real values. Never commit .env.

# DeepSeek API key (required only for live LLM calls; tests never need it).
DEEPSEEK_API_KEY=

# OpenAI-compatible base URL for DeepSeek.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model used by the generator, and by the critic unless DEEPSEEK_CRITIC_MODEL is set.
DEEPSEEK_MODEL=deepseek-flash
# Optional separate model for the critic, e.g. deepseek-v4-pro. Leave empty to use DEEPSEEK_MODEL.
DEEPSEEK_CRITIC_MODEL=

# Optional overrides. Uncomment a line to change it; the values shown are the defaults.
# Thinking mode: the model reasons before answering (temperature is then ignored).
# KNOWCODE_GENERATOR_THINKING=false
# KNOWCODE_CRITIC_THINKING=true
# KNOWCODE_GENERATOR_TEMPERATURE=0.3
# KNOWCODE_CRITIC_TEMPERATURE=0.0
# KNOWCODE_GENERATOR_MAX_TOKENS=1000
# KNOWCODE_CRITIC_MAX_TOKENS=8000
# KNOWCODE_REQUEST_TIMEOUT_SECONDS=120
# KNOWCODE_RETRY_BASE_DELAY_SECONDS=1.0
# KNOWCODE_MAX_TECHNICAL_RETRIES=3
# KNOWCODE_MAX_QUALITY_RETRIES=1
# KNOWCODE_PASS_THRESHOLD=4
# KNOWCODE_MAX_CHUNK_TOKENS=6000
